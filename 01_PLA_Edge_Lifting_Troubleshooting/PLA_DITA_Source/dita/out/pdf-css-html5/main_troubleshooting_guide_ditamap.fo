apse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--BOTTOM-CENTER--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="center" display-align="center" font-size="8pt" font-family="Roboto , sans-serif" color="rgb(102 , 102 , 102)"><fo:block><fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="8pt" font-family="Roboto , sans-serif" color="rgb(102 , 102 , 102)"><fo:block>PLA Edge Lifting Troubleshooting Guide</fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-after-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--BOTTOM-CENTER--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="center" display-align="center" font-size="8pt" font-family="Roboto , sans-serif" color="rgb(102 , 102 , 102)"><fo:block><fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en"><fo:block-container space-before="1em" role="Sect" id="unique_58" chfox:nd-id="why-pla-prints-develop-edge-lifting-and-minor-warping"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title58"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Why PLA prints develop edge lifting and minor warping</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 4 - <!--content(text)--><fo:inline>Why PLA prints develop edge lifting and minor warping</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 4 - <!--content(text)--><fo:inline>Why PLA prints develop edge lifting and minor warping</fo:inline></fo:marker><fo:inline>Chapter 4. </fo:inline><fo:inline>Why PLA prints develop edge lifting and
                                    minor warping</fo:inline></fo:block></fo:block-container>
                            
                            <fo:block role="Sect" id="unique_59" chfox:nd-id="why-the-problem-happens">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title59"><fo:block end-indent="0" start-indent="0"><fo:inline>Why the problem happens</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">PLA cools and
                                        shrinks slightly as each layer is deposited. That shrinkage
                                        creates an upward pulling force on the lower edges of the
                                        part.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The build plate
                                        must hold the part down while this happens. When the
                                        shrinkage force becomes stronger than build plate adhesion,
                                        the edges begin to lift.</fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="unique_59_Connect_42_fig_explanation" chfox:nd-id="fig_explanation"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid"><fo:inline>Figure<fo:inline> 4</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Edge lifting begins when
                                                  cooling shrinkage overcomes build plate adhesion
                                                  at the edge.</fo:inline></fo:inline></fo:block>
                                        <fo:block text-align="center">
                                            <fo:table width="100%" table-layout="fixed" space-after="1em"><fo:table-column column-width="(100% - 434px) div 2"/><fo:table-column column-width="434px"/><fo:table-column column-width="(100% - 434px) div 2"/><fo:table-body><fo:table-row><fo:table-cell start-indent="0" end-indent="0"><fo:block/></fo:table-cell><fo:table-cell start-indent="0" end-indent="0"><fo:block-container height="325px" max-width="100%"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/Users/joy/vscode/3d%20printer/dita/the_basic_mechanism_of_warping.png" fox:alt-text="A simple diagram of a printed part on a build plate, with arrows showing upward pulling force from cooling shrinkage and downward holding force from build plate adhesion." max-width="100%" scaling="non-uniform" content-width="434px" content-height="325px"/></fo:inline></fo:block></fo:block-container></fo:table-cell><fo:table-cell start-indent="0" end-indent="0"><fo:block/></fo:table-cell></fo:table-row></fo:table-body></fo:table>
                                        </fo:block>
                                    </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="unique_60" chfox:nd-id="why-corners-usually-lift-first">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title60"><fo:block end-indent="0" start-indent="0"><fo:inline>Why corners usually lift
                                    first</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Corners often lift
                                        first because they have less surrounding material and more
                                        exposure to open-air cooling. Once a corner lifts, the
                                        nearby edge often follows.</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="unique_61" chfox:nd-id="why-large-flat-parts-warp-more-easily">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title61"><fo:block end-indent="0" start-indent="0"><fo:inline>Why large flat parts warp more
                                        easily</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Large flat parts
                                        create more total shrinkage stress as PLA cools.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Long straight
                                        edges can also accumulate stress in one direction. This can
                                        make the lower perimeter more likely to pull away from the
                                        build plate.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For that reason,
                                        parts that look simple because they have a large flat base
                                        may actually be harder to keep fully attached during
                                        printing.</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="unique_62" chfox:nd-id="why-the-first-layers-matter-most">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title62"><fo:block end-indent="0" start-indent="0"><fo:inline>Why the first layers matter
                                    most</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The first layers
                                        determine how well the rest of the part stays anchored to
                                        the build plate.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">If first-layer
                                        contact is weak, later shrinkage forces become more visible.
                                        As the print grows taller, the lower edges may be pulled
                                        upward more easily.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For that reason,
                                        edge lifting and minor warping often begin as an early
                                        first-layer problem, even when the print continues for some
                                        time afterward.</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                        </fo:block></fo:block-container>
                        </fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" id="last-page-sequence" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-after-left-first-blank" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--BOTTOM-CENTER--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="center" display-align="center" font-size="8pt" font-family="Roboto , sans-serif" color="rgb(102 , 102 , 102)"><fo:block><fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-after-left-first" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--BOTTOM-CENTER--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="center" display-align="center" font-size="8pt" font-family="Roboto , sans-serif" color="rgb(102 , 102 , 102)"><fo:block><fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-after-left-blank" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--BOTTOM-CENTER--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="center" display-align="center" font-size="8pt" font-family="Roboto , sans-serif" color="rgb(102 , 102 , 102)"><fo:block><fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="8pt" font-family="Roboto , sans-serif" color="rgb(102 , 102 , 102)"><fo:block>PLA Edge Lifting Troubleshooting Guide</fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-after-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--BOTTOM-CENTER--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="center" display-align="center" font-size="8pt" font-family="Roboto , sans-serif" color="rgb(102 , 102 , 102)"><fo:block><fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-after-right-first-blank" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--BOTTOM-CENTER--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="center" display-align="center" font-size="8pt" font-family="Roboto , sans-serif" color="rgb(102 , 102 , 102)"><fo:block><fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-after-right-first" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--BOTTOM-CENTER--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="center" display-align="center" font-size="8pt" font-family="Roboto , sans-serif" color="rgb(102 , 102 , 102)"><fo:block><fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-after-right-blank" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--BOTTOM-CENTER--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="center" display-align="center" font-size="8pt" font-family="Roboto , sans-serif" color="rgb(102 , 102 , 102)"><fo:block><fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="8pt" font-family="Roboto , sans-serif" color="rgb(102 , 102 , 102)"><fo:block>PLA Edge Lifting Troubleshooting Guide</fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-after-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--BOTTOM-CENTER--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="center" display-align="center" font-size="8pt" font-family="Roboto , sans-serif" color="rgb(102 , 102 , 102)"><fo:block><fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en"><fo:block-container space-before="1em" role="Sect" id="unique_63" chfox:nd-id="key-terms-for-pla-edge-lifting-troubleshooting"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title63"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Key terms for PLA edge lifting troubleshooting</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 5 - <!--content(text)--><fo:inline>Key terms for PLA edge lifting troubleshooting</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 5 - <!--content(text)--><fo:inline>Key terms for PLA edge lifting troubleshooting</fo:inline></fo:marker><fo:inline>Chapter 5. </fo:inline><fo:inline>Key terms for PLA edge lifting
                                    troubleshooting</fo:inline></fo:block></fo:block-container>
                            
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block>
                                    <fo:table-and-caption border-collapse="collapse" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" space-before="0.5em" text-align="center"><fo:block end-indent="0" start-indent="0"/></fo:block-container></fo:table-caption><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" border-bottom-color="black" border-bottom-style="solid" border-bottom-width="1px" border-left-color="black" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="black" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="black" border-top-style="solid" border-top-width="1px" hyphenate="true" space-before="0" space-after="0"><fo:table-column/><fo:table-column/><fo:table-header font-weight="bold" text-align="center" display-align="center">
                                            <fo:table-row display-align="center">
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" id="unique_63__entry__1"><fo:block>Term</fo:block></fo:table-cell>
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" id="unique_63__entry__2"><fo:block>Definition</fo:block></fo:table-cell>
                                            </fo:table-row>
                                        </fo:table-header><fo:table-body display-align="center">
                                            <fo:table-row display-align="center">
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>First
                                                  layer</fo:block></fo:table-cell>
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>The
                                                  first printed layer placed directly onto the build
                                                  plate. Its quality affects how well the rest of
                                                  the part stays attached during printing.</fo:block></fo:table-cell>
                                            </fo:table-row>
                                            <fo:table-row display-align="center">
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>First-layer calibration</fo:block></fo:table-cell>
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>The
                                                  process of checking and adjusting first-layer
                                                  contact so that the printed lines bond correctly
                                                  to the build plate.</fo:block></fo:table-cell>
                                            </fo:table-row>
                                            <fo:table-row display-align="center">
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>Build
                                                  plate adhesion</fo:block></fo:table-cell>
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>The
                                                  ability of a printed part to stay attached to the
                                                  build plate while it is being printed.</fo:block></fo:table-cell>
                                            </fo:table-row>
                                            <fo:table-row display-align="center">
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>Brim</fo:block></fo:table-cell>
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>A thin
                                                  ring of extra printed material added around the
                                                  base of a part to increase contact area.</fo:block></fo:table-cell>
                                            </fo:table-row>
                                            <fo:table-row display-align="center">
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>Z-offset</fo:block></fo:table-cell>
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>A
                                                  printer setting that adjusts the nozzle height
                                                  relative to the build plate. It is often used to
                                                  fine-tune first-layer contact.</fo:block></fo:table-cell>
                                            </fo:table-row>
                                            <fo:table-row display-align="center">
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>Build
                                                  surface profile</fo:block></fo:table-cell>
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>The
                                                  slicer or printer setting that matches the
                                                  installed build surface or plate type.</fo:block></fo:table-cell>
                                            </fo:table-row>
                                            <fo:table-row display-align="center">
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>Bottom
                                                  surface pattern</fo:block></fo:table-cell>
                                                <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>The
                                                  path strategy used for the solid bottom layers
                                                  where the print meets the build plate.</fo:block></fo:table-cell>
                                            </fo:table-row>
                                            <fo:table-row display-align="center">
                                                <fo:table-cell start-indent="0" end-indent="0" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>Infill
                                                  pattern</fo:block></fo:table-cell>
                                                <fo:table-cell start-indent="0" end-indent="0" hyphenate="false" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="left" display-align="before"><fo:block>The
                                                  path pattern used to print the internal support
                                                  structure inside a part.</fo:block></fo:table-cell>
                                            </fo:table-row>
                                        </fo:table-body></fo:table></fo:table-and-caption>
                                </fo:block>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"><fo:inline font-weight="bold">Note:</fo:inline> Bottom surface pattern
                                    affects the solid lower surface. Infill pattern affects the
                                    internal structure.</fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                        </fo:block></fo:block-container>
                    </fo:block>
                </fo:block></fo:block-container>
            </fo:block>
        </fo:block></fo:block-container>
    </fo:block></fo:block-container>
</fo:block></fo:flow></fo:page-sequence></fo:root>